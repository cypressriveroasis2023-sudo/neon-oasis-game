    },
    {
      "schemaname": "storage",
      "tablename": "objects",
      "policyname": "techcheck_transfer_read",
      "permissive": "PERMISSIVE",
      "roles": "{authenticated}",
      "cmd": "SELECT",
      "qual": "((bucket_id = 'techcheck-transfer-evidence'::text) AND app_private.techcheck_transfer_file(name, false))",
      "with_check": null
    }
  ],
